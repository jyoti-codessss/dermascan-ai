# DermaScan AI Backend Environment Variables
PORT=5001
NODE_ENV=development

# MongoDB Connection (Local or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/dermascan_ai

# JWT Security Secrets (Use high-entropy random keys in production)
JWT_SECRET=dermascan_jwt_access_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=dermascan_jwt_refresh_secret_key_change_in_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20
